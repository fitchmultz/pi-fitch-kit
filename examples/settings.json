{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-astra",
  "defaultThinkingLevel": "medium",
  "compactView": true,
  "enabledModels": [
    "anthropic/claude-opus-5-5",
    "cloudflare-ai-gateway/claude-opus-5-5",
    "cloudflare-ai-gateway/claude-opus-5",
    "openai-codex/gpt-6-astra",
    "openai/gpt-6-astra",
    "openai/gpt-6-sol",
    "xai/grok-4.7"
  ],
  "images": {
    "autoResize": false
  },
  "terminal": {
    "imageWidthCells": 120
  },
  "steeringMode": "all",
  "retry": {
    "enabled": true,
    "maxRetries": 5,
    "provider": {
      "timeoutMs": 150000
    }
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 64000,
    "keepRecentTokens": 40000
  }
}
