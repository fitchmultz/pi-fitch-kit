{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-astra",
  "defaultThinkingLevel": "xhigh",
  "enabledModels": [
    "anthropic/claude-fable-5-2",
    "cloudflare-ai-gateway/claude-opus-5-5",
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6.1-sol",
    "openai-codex/gpt-6.1-terra",
    "openai-codex/gpt-6-luna",
    "cloudflare-ai-gateway/gpt-6-astra",
    "cloudflare-ai-gateway/gpt-6.1-sol",
    "cloudflare-ai-gateway/gpt-6.1-terra",
    "cloudflare-ai-gateway/gpt-6-luna"
  ],
  "defaultTools": ["+codemode", "+tool_search", "+grep", "+find", "+ls"],
  "extensions": ["-builtin:mcp"],
  "steeringMode": "all",
  "compactView": true,
  "images": {
    "autoResize": false
  },
  "terminal": {
    "imageWidthCells": 120
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 64000,
    "keepRecentTokens": 30000
  }
}
