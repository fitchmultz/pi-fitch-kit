{
  "schemaVersion": 2,
  "runtime": {
    "pi": "0.83.0",
    "node": ">=22.19.0"
  },
  "kit": {
    "repository": "https://github.com/fitchmultz/pi-fitch-kit",
    "installSource": "git:github.com/fitchmultz/pi-fitch-kit"
  },
  "requiredModels": [
    "xai/grok-4.5",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-5.6-luna",
    "anthropic/claude-fable-5",
    "anthropic/claude-opus-5"
  ],
  "optionalModels": [
    "openai/gpt-5.6-sol",
    "cursor/grok-4.5",
    "cursor/gpt-5.6-sol@272k"
  ],
  "optionalModelsNote": "Fallback-only routes. openai/gpt-5.6-sol needs an OpenAI API key; the cursor/* routes need the pi-cursor-sdk package and a Cursor SDK API key. Missing them only removes those fallbacks.",
  "kitResources": {
    "extensions": ["extensions/sync-agents.ts"],
    "prompt": "prompts/fitch-setup.md",
    "agentProfiles": 14,
    "workingAgreementTemplate": "templates/working-agreement.md"
  },
  "corePackages": [
    {
      "id": "subagents",
      "source": "git:github.com/fitchmultz/pi-subagents@4f55ff92c92581eff2ab79810d5f9b9087a7a14a"
    },
    {
      "id": "intercom",
      "source": "git:github.com/fitchmultz/pi-intercom@8c3e345056c3244d3442108aaf76f3d94f934f41"
    },
    {
      "id": "apply-edits",
      "source": "git:github.com/fitchmultz/pi-apply-edits@1668d22a66a7d43d7aa06b3964fd27efda43b909"
    },
    {
      "id": "ask-question",
      "source": "git:github.com/fitchmultz/pi-ask-question@06fe72b3326cc178c821754a524021a4da83162d"
    },
    {
      "id": "todo-list",
      "source": "git:github.com/fitchmultz/pi-todo-list@78b7851eb06e22993c16b374255b8b362254ac2a"
    },
    {
      "id": "session-name",
      "source": "git:github.com/fitchmultz/pi-session-name@bd851ba19208a395b3be0fe006b2b3402cc20fbc"
    },
    {
      "id": "ponytail",
      "source": "git:github.com/DietrichGebert/ponytail@16f29800fd2681bdf24f3eb4ccffe38be3baec6b"
    },
    {
      "id": "fff",
      "source": "npm:@ff-labs/pi-fff@0.10.1"
    },
    {
      "id": "agent-browser",
      "source": "npm:pi-agent-browser-native@0.2.72",
      "externalPrerequisite": {
        "package": "agent-browser",
        "version": "0.33.1",
        "installCommand": "npm install --global agent-browser@0.33.1",
        "runtimeDownloadCommand": "agent-browser install"
      }
    },
    {
      "id": "mcp",
      "source": "npm:pi-mcp-adapter@2.17.0"
    },
    {
      "id": "goal",
      "source": "npm:pi-codex-goal@0.1.39"
    },
    {
      "id": "stash",
      "source": "npm:@fitchmultz/pi-stash@0.1.24"
    },
    {
      "id": "verbosity",
      "source": "npm:pi-verbosity-control@0.3.0"
    },
    {
      "id": "tool-duration",
      "source": "npm:pi-tool-duration@0.1.4"
    },
    {
      "id": "edit-session",
      "source": "npm:pi-edit-session-in-place@0.1.26"
    },
    {
      "id": "copy-message",
      "source": "npm:pi-copy-message@1.0.11"
    },
    {
      "id": "cursor-sdk",
      "source": "npm:pi-cursor-sdk@0.1.62",
      "note": "Supplies the cursor/* fallback routes. Needs a Cursor SDK API key saved through /login; skipping it only removes those fallbacks."
    }
  ],
  "privatePackages": [
    {
      "id": "macuse",
      "reason": "Private repository. Native macOS app control stays unavailable unless the user provides an approved source."
    },
    {
      "id": "pr-hawk",
      "reason": "Private repository. Pull-request watching stays unavailable unless the user provides an approved source."
    }
  ],
  "optionalIntegrations": [
    "Linear",
    "Slack",
    "GitHub",
    "Horizon",
    "Plain",
    "Granola",
    "Notion",
    "Cloudflare",
    "Sentry",
    "Datadog"
  ],
  "workingAgreementSections": ["baseline", "process"]
}
