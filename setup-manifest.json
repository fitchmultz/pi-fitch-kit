{
  "schemaVersion": 7,
  "runtime": {
    "pi": "0.84.2",
    "node": ">=24.0.0"
  },
  "kit": {
    "packageName": "@fitch/pi-kit",
    "repository": "https://github.com/fitchmultz/pi-fitch-kit",
    "installSource": "git:github.com/fitchmultz/pi-fitch-kit"
  },
  "requiredModels": [
    "anthropic/claude-fable-5",
    "anthropic/claude-opus-5",
    "openai/gpt-5.6-sol"
  ],
  "optionalModels": [
    "cloudflare-ai-gateway/claude-fable-5",
    "cloudflare-ai-gateway/claude-opus-5",
    "cloudflare-ai-gateway/grok-4.6",
    "openai-codex/gpt-5.6-sol",
    "xai/grok-4.6",
    "fireworks/accounts/fireworks/routers/kimi-k3-fast",
    "fireworks/accounts/fireworks/routers/glm-5p2-fast",
    "cf-google/gemini-3.7-flash"
  ],
  "optionalModelsNote": "Gateway, Codex, xAI, Fireworks, and cf-google routes mirror the owner's active setup but require each user's own provider definitions and authentication. Missing routes remove the associated primary, fallback, or model-cycle entry while the required direct routes keep the public setup usable.",
  "modelContextWindows": {
    "cloudflare-ai-gateway/claude-fable-5": 320000,
    "cloudflare-ai-gateway/claude-opus-5": 320000,
    "anthropic/claude-fable-5": 320000,
    "anthropic/claude-opus-5": 320000,
    "openai/gpt-5.6-sol": 320000,
    "openai-codex/gpt-5.6-sol": 320000
  },
  "modelContextWindowsNote": "Flat compaction-policy windows, merged per route into models.json as modelOverrides { contextWindow }. The 320000 override lowers the ~1M direct Anthropic routes, raises the 272000 direct OpenAI and Codex routes into OpenAI's long-context pricing tier once actual input exceeds 272k, and matches the verified Claude gateway routes. Gateway Grok, xAI Grok, Fireworks, and cf-google are user-managed full model definitions in the owner's setup; the kit does not reproduce their private endpoints or pricing metadata, and those definitions must carry their own 320k window.",
  "kitResources": {
    "extensions": [
      "extensions/anthropic-image-guard.ts",
      "extensions/clean-footer.ts",
      "extensions/fast-mode.ts",
      "extensions/session-name.ts",
      "extensions/write-prompt.ts"
    ],
    "prompts": [
      "prompts/fitch-setup.md",
      "prompts/audit/github-open-issues-prs.md"
    ],
    "themes": [
      "themes/calm.json"
    ],
    "workingAgreementTemplate": "templates/working-agreement.md",
    "settingsExample": "examples/settings.json"
  },
  "consentBehaviors": [],
  "retiredPackageSources": [
    "git:github.com/fitchmultz/pi-codex-context",
    "git:github.com/fitchmultz/pi-session-name",
    "git:github.com/fitchmultz/pi-ask-question",
    "npm:@ff-labs/pi-fff"
  ],
  "corePackages": [
    {
      "id": "subagents",
      "source": "git:github.com/fitchmultz/pi-subagents"
    },
    {
      "id": "apply-edits",
      "source": "git:github.com/fitchmultz/pi-apply-edits"
    },
    {
      "id": "todo-list",
      "source": "git:github.com/fitchmultz/pi-todo-list"
    },
    {
      "id": "change-working-dir",
      "source": "git:github.com/fitchmultz/pi-change-working-dir"
    },
    {
      "id": "ponytail",
      "source": "git:github.com/DietrichGebert/ponytail"
    },
    {
      "id": "agent-browser",
      "source": "git:github.com/fitchmultz/pi-agent-browser-native",
      "externalPrerequisite": {
        "package": "agent-browser",
        "version": "0.33.2",
        "installCommand": "npm install --global agent-browser@0.33.2",
        "runtimeDownloadCommand": "agent-browser install"
      }
    },
    {
      "id": "mcp",
      "source": "git:github.com/fitchmultz/pi-mcp-adapter"
    },
    {
      "id": "stash",
      "source": "git:github.com/fitchmultz/pi-stash"
    },
    {
      "id": "verbosity",
      "source": "npm:pi-verbosity-control"
    },
    {
      "id": "tool-duration",
      "source": "git:github.com/fitchmultz/pi-tool-duration"
    },
    {
      "id": "edit-session",
      "source": "git:github.com/fitchmultz/pi-edit-session-in-place"
    },
    {
      "id": "copy-message",
      "source": "git:github.com/fitchmultz/pi-copy-message"
    },
    {
      "id": "calculator",
      "source": "git:github.com/fitchmultz/pi-calculator"
    },
    {
      "id": "ctx-info",
      "source": "git:github.com/fitchmultz/pi-ctx-info"
    },
    {
      "id": "agent-skills",
      "source": "git:github.com/fitchmultz/pi-agent-skills"
    }
  ],
  "optionalIntegrations": [
    "Horizon",
    "GitHub",
    "Linear",
    "Slack",
    "Cloudflare",
    "Sentry",
    "Datadog",
    "Plain",
    "Notion",
    "Granola"
  ],
  "workingAgreementSections": [
    "baseline",
    "process"
  ]
}
