{
  "schemaVersion": 3,
  "runtime": {
    "pi": "0.83.0",
    "node": ">=24.0.0"
  },
  "kit": {
    "repository": "https://github.com/fitchmultz/pi-fitch-kit",
    "installSource": "git:github.com/fitchmultz/pi-fitch-kit@v0.2.2"
  },
  "requiredModels": [
    "xai/grok-4.5",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-5.6-luna",
    "anthropic/claude-fable-5",
    "anthropic/claude-opus-5"
  ],
  "optionalModels": [
    "openai/gpt-5.6-sol",
    "openai/gpt-5.6-luna"
  ],
  "optionalModelsNote": "Fallback-only routes. The openai/* routes need an OpenAI API key; missing them only removes those fallbacks.",
  "kitResources": {
    "extensions": [
      "extensions/anthropic-image-guard.ts"
    ],
    "prompts": [
      "prompts/fitch-setup.md",
      "prompts/audit/github-open-issues-prs.md"
    ],
    "workingAgreementTemplate": "templates/working-agreement.md",
    "settingsExample": "examples/settings.json"
  },
  "corePackages": [
    {
      "id": "subagents",
      "source": "git:github.com/fitchmultz/pi-subagents@3dd2c4932b8aff8a40ed25f98023aebd35685830"
    },
    {
      "id": "intercom",
      "source": "git:github.com/fitchmultz/pi-intercom@aa199a544c3a0daceea0d0dd853dde72ff3c3eca"
    },
    {
      "id": "apply-edits",
      "source": "git:github.com/fitchmultz/pi-apply-edits@f30df49f5fa651a6948ae48967397d5db7d50003"
    },
    {
      "id": "ask-question",
      "source": "git:github.com/fitchmultz/pi-ask-question@06fe72b3326cc178c821754a524021a4da83162d"
    },
    {
      "id": "todo-list",
      "source": "git:github.com/fitchmultz/pi-todo-list@e309172666eb2aeb953c5a4aba55695ef7dbd2cc"
    },
    {
      "id": "session-name",
      "source": "git:github.com/fitchmultz/pi-session-name@bd851ba19208a395b3be0fe006b2b3402cc20fbc"
    },
    {
      "id": "change-working-dir",
      "source": "git:github.com/fitchmultz/pi-change-working-dir@58437bd9f5c34bc5364aed9c6f3b91049e93f243"
    },
    {
      "id": "ponytail",
      "source": "git:github.com/DietrichGebert/ponytail@16f29800fd2681bdf24f3eb4ccffe38be3baec6b"
    },
    {
      "id": "fff",
      "source": "npm:@ff-labs/pi-fff@0.10.1"
    },
    {
      "id": "agent-browser",
      "source": "git:github.com/fitchmultz/pi-agent-browser-native@14d05acbfe98a04d5614b904eb51632d48845b25",
      "externalPrerequisite": {
        "package": "agent-browser",
        "version": "0.33.0",
        "installCommand": "npm install --global agent-browser@0.33.0",
        "runtimeDownloadCommand": "agent-browser install"
      }
    },
    {
      "id": "mcp",
      "source": "npm:pi-mcp-adapter@2.18.0"
    },
    {
      "id": "stash",
      "source": "npm:@fitchmultz/pi-stash@0.1.24"
    },
    {
      "id": "verbosity",
      "source": "npm:pi-verbosity-control@0.3.0"
    },
    {
      "id": "tool-duration",
      "source": "npm:pi-tool-duration@0.1.4"
    },
    {
      "id": "edit-session",
      "source": "npm:pi-edit-session-in-place@0.1.27"
    },
    {
      "id": "copy-message",
      "source": "npm:pi-copy-message@1.0.11"
    },
    {
      "id": "codex-context",
      "source": "git:github.com/fitchmultz/pi-codex-context@b2c52ebd47fac2b38750168ea0d648ecd6c03a96",
      "consent": {
        "required": true,
        "default": "disabled",
        "data": "retained compaction context, including messages selected for summarization, prior summaries, split-turn prefixes, and custom instructions",
        "destinations": [
          "xai/grok-4.5",
          "openai-codex/gpt-5.6-luna"
        ],
        "configPath": "${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/pi-codex-context.json",
        "config": {
          "customCompactionEnabled": true,
          "compactionModels": [
            {
              "provider": "xai",
              "model": "grok-4.5",
              "thinkingLevel": "high"
            },
            {
              "provider": "openai-codex",
              "model": "gpt-5.6-luna",
              "thinkingLevel": "high"
            }
          ]
        }
      }
    },
    {
      "id": "calculator",
      "source": "git:github.com/fitchmultz/pi-calculator@d6b4a6c4efff2d68ecaff79c954bb63cecd5c330"
    },
    {
      "id": "agent-skills",
      "source": "git:github.com/fitchmultz/pi-agent-skills@f7df41c32f9d174aa4b552aa42266d860760b1a0"
    }
  ],
  "optionalIntegrations": [
    "Horizon",
    "GitHub",
    "Linear",
    "Slack",
    "Cloudflare",
    "Sentry",
    "Datadog",
    "Plain",
    "Notion",
    "Granola"
  ],
  "workingAgreementSections": [
    "baseline",
    "process"
  ]
}
