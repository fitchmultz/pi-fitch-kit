{
  "schemaVersion": 9,
  "runtime": {
    "pi": ">=1.5.2",
    "node": "^24.22.3 || >=26.13.1"
  },
  "kit": {
    "packageName": "@fitch/pi-kit",
    "repository": "https://github.com/fitchmultz/pi-fitch-kit",
    "installSource": "git:github.com/fitchmultz/pi-fitch-kit"
  },
  "kitResources": {
    "extensions": [
      "extensions/anthropic-image-guard.ts",
      "extensions/clean-footer.ts",
      "extensions/fast-mode.ts",
      "extensions/session-name.ts",
      "extensions/setup-models.ts",
      "extensions/write-prompt.ts"
    ],
    "prompts": ["prompts/fitch-setup.md", "prompts/audit/github-open-issues-prs.md"],
    "themes": ["themes/calm.json"],
    "workingAgreementTemplate": "templates/working-agreement.md",
    "settingsExample": "examples/settings.json"
  },
  "corePackages": [
    {
      "id": "subagents",
      "source": "git:github.com/fitchmultz/pi-subagents",
      "provides": "Delegation to fresh or forked child sessions, saved child runs, and messaging between local sessions"
    },
    {
      "id": "apply-edits",
      "source": "git:github.com/fitchmultz/pi-apply-edits",
      "provides": "File edits: apply_patch, replace_text, and write_files"
    },
    {
      "id": "posthorse",
      "source": "git:github.com/fitchmultz/pi-posthorse",
      "provides": "Context rollover without a model-written summary, task notes, and history search"
    },
    {
      "id": "agent-browser",
      "source": "git:github.com/fitchmultz/pi-agent-browser-native",
      "provides": "Browser automation and web search",
      "externalPrerequisite": {
        "command": "agent-browser",
        "instructions": "https://github.com/fitchmultz/pi-agent-browser-native#install-and-start"
      }
    },
    {
      "id": "mcp",
      "source": "git:github.com/fitchmultz/pi-mcp-adapter",
      "provides": "MCP servers as searchable, deferred Pi tools"
    },
    {
      "id": "ask-question",
      "source": "git:github.com/fitchmultz/pi-ask-question",
      "provides": "Structured questions in the Pi UI"
    },
    {
      "id": "change-working-dir",
      "source": "git:github.com/fitchmultz/pi-change-working-dir",
      "provides": "Mid-session working-directory changes"
    },
    {
      "id": "calculator",
      "source": "git:github.com/fitchmultz/pi-calculator",
      "provides": "Deterministic high-precision arithmetic"
    },
    {
      "id": "ctx-info",
      "source": "git:github.com/fitchmultz/pi-ctx-info",
      "provides": "/ctx breakdown of context usage"
    },
    {
      "id": "stash",
      "source": "git:github.com/fitchmultz/pi-stash",
      "provides": "Stash and restore a draft message"
    },
    {
      "id": "copy-message",
      "source": "git:github.com/fitchmultz/pi-copy-message",
      "provides": "Search and copy raw session messages"
    },
    {
      "id": "agent-skills",
      "source": "git:github.com/fitchmultz/pi-agent-skills",
      "provides": "Review, QA, diagram, handoff, and Pi development skills"
    },
    {
      "id": "pstack",
      "source": "git:github.com/fitchmultz/pi-pstack",
      "provides": "Engineering workflow skills adapted from Cursor's pstack"
    }
  ],
  "optionalPackages": [
    {
      "id": "macuse",
      "source": "git:github.com/fitchmultz/macuse",
      "provides": "Experimental native macOS app control through the Computer Use runtime installed with ChatGPT",
      "platform": "darwin"
    }
  ],
  "retiredPackageSources": [
    "git:github.com/fitchmultz/pi-codex-context",
    "git:github.com/fitchmultz/pi-session-name",
    "git:github.com/fitchmultz/pi-intercom"
  ],
  "retiredPackageSourcesNote": "Archived packages whose tools or commands now ship in the kit or in pi-subagents. Loading one beside its replacement registers the same tool or command twice.",
  "modelContextWindows": {
    "anthropic/claude-fable-5-2": 400000,
    "cloudflare-ai-gateway/claude-opus-5-5": 400000,
    "openai-codex/gpt-6-astra": 400000,
    "openai-codex/gpt-6.1-sol": 400000,
    "openai-codex/gpt-6.1-terra": 400000,
    "openai-codex/gpt-6-luna": 400000,
    "cloudflare-ai-gateway/gpt-6-astra": 400000,
    "cloudflare-ai-gateway/gpt-6.1-sol": 400000,
    "cloudflare-ai-gateway/gpt-6.1-terra": 400000,
    "cloudflare-ai-gateway/gpt-6-luna": 400000
  },
  "modelContextWindowsNote": "The model routes this setup uses and the context window chosen for each. Every route is optional and needs the user's own authentication. Setup offers only routes available in the running session and merges a selected window as modelOverrides { contextWindow }, which keeps the model's native capabilities and pricing. A window can be larger or smaller than the route's native value; check the route's long-context pricing before raising one.",
  "workingAgreementSections": ["baseline", "process"]
}
