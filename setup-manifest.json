{
  "schemaVersion": 8,
  "runtime": {
    "pi": ">=0.84.2",
    "node": ">=24.0.0"
  },
  "kit": {
    "packageName": "@fitch/pi-kit",
    "repository": "https://github.com/fitchmultz/pi-fitch-kit",
    "installSource": "git:github.com/fitchmultz/pi-fitch-kit"
  },
  "requiredModels": [
    ["openai-codex/gpt-6-astra", "openai/gpt-6-astra"],
    ["anthropic/claude-opus-5-5", "cloudflare-ai-gateway/claude-opus-5-5", "cloudflare-ai-gateway/claude-opus-5"]
  ],
  "requiredModelsNote": "Each entry is an ordered list of alternatives; the first available route satisfies it. Claude matches pi-subagents' reviewer-claude chain; gateway Opus 5 is the newest Claude that official Pi's gateway catalog names with a working id.",
  "optionalModels": [
    "anthropic/claude-fable-5-1",
    "cloudflare-ai-gateway/claude-fable-5-1",
    "openai/gpt-6-sol",
    "xai/grok-4.7"
  ],
  "optionalModelsNote": "Optional routes require the user's own authentication and, where needed, provider configuration. Missing routes are reported and omitted from the selected setup; existing user profiles and fallbacks are preserved.",
  "modelContextWindows": {
    "anthropic/claude-fable-5-1": 300000,
    "anthropic/claude-opus-5-5": 300000,
    "cloudflare-ai-gateway/claude-fable-5-1": 300000,
    "cloudflare-ai-gateway/claude-opus-5": 300000,
    "cloudflare-ai-gateway/claude-opus-5-5": 300000,
    "openai/gpt-6-astra": 300000,
    "openai-codex/gpt-6-astra": 300000,
    "xai/grok-4.7": 300000
  },
  "modelContextWindowsNote": "Optional budgets, merged per route as modelOverrides { contextWindow } to inherit native model capabilities. Existing choices remain unchanged unless explicitly overwritten. Inspect the effective model's pricing tiers before raising its window; the kit does not copy private provider definitions or pricing.",
  "kitResources": {
    "extensions": [
      "extensions/anthropic-image-guard.ts",
      "extensions/clean-footer.ts",
      "extensions/fast-mode.ts",
      "extensions/session-name.ts",
      "extensions/setup-models.ts",
      "extensions/write-prompt.ts"
    ],
    "prompts": [
      "prompts/fitch-setup.md",
      "prompts/audit/github-open-issues-prs.md"
    ],
    "themes": [
      "themes/calm.json"
    ],
    "workingAgreementTemplate": "templates/working-agreement.md",
    "settingsExample": "examples/settings.json"
  },
  "consentBehaviors": [],
  "retiredPackageSources": [
    "git:github.com/fitchmultz/pi-codex-context",
    "git:github.com/fitchmultz/pi-session-name",
    "npm:@ff-labs/pi-fff",
    "npm:pi-verbosity-control",
    "git:github.com/DietrichGebert/ponytail"
  ],
  "retiredExtensionLinks": [
    {
      "path": "extensions/fold-responsive-footer.ts",
      "targetSuffix": "/fold-dev-environment/extensions/fold-responsive-footer.ts"
    },
    {
      "path": "extensions/openai-codex-fast-mode",
      "targetSuffix": "/fold-dev-environment/extensions/openai-codex-fast-mode"
    }
  ],
  "corePackages": [
    {
      "id": "subagents",
      "source": "git:github.com/fitchmultz/pi-subagents"
    },
    {
      "id": "apply-edits",
      "source": "git:github.com/fitchmultz/pi-apply-edits"
    },
    {
      "id": "ask-question",
      "source": "git:github.com/fitchmultz/pi-ask-question"
    },
    {
      "id": "todo-list",
      "source": "git:github.com/fitchmultz/pi-todo-list"
    },
    {
      "id": "change-working-dir",
      "source": "git:github.com/fitchmultz/pi-change-working-dir"
    },
    {
      "id": "ponytail",
      "source": "git:github.com/fitchmultz/ponytail"
    },
    {
      "id": "agent-browser",
      "source": "git:github.com/fitchmultz/pi-agent-browser-native",
      "externalPrerequisite": {
        "package": "agent-browser",
        "version": "0.38.1",
        "installCommand": "npm install --global agent-browser@0.38.1",
        "runtimeDownloadCommand": "agent-browser install"
      }
    },
    {
      "id": "mcp",
      "source": "git:github.com/fitchmultz/pi-mcp-adapter"
    },
    {
      "id": "stash",
      "source": "git:github.com/fitchmultz/pi-stash"
    },
    {
      "id": "verbosity",
      "source": "git:github.com/fitchmultz/pi-verbosity-control"
    },
    {
      "id": "tool-duration",
      "source": "git:github.com/fitchmultz/pi-tool-duration"
    },
    {
      "id": "edit-session",
      "source": "git:github.com/fitchmultz/pi-edit-session-in-place"
    },
    {
      "id": "copy-message",
      "source": "git:github.com/fitchmultz/pi-copy-message"
    },
    {
      "id": "calculator",
      "source": "git:github.com/fitchmultz/pi-calculator"
    },
    {
      "id": "ctx-info",
      "source": "git:github.com/fitchmultz/pi-ctx-info"
    },
    {
      "id": "agent-skills",
      "source": "git:github.com/fitchmultz/pi-agent-skills"
    }
  ],
  "optionalIntegrations": [
    "Horizon",
    "GitHub",
    "Linear",
    "Slack",
    "Cloudflare",
    "Sentry",
    "Datadog",
    "Plain",
    "Notion",
    "Granola"
  ],
  "workingAgreementSections": [
    "baseline",
    "process"
  ]
}
