{
  "name": "@fitch/pi-kit",
  "version": "0.18.2",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fitchmultz/pi-fitch-kit.git"
  },
  "homepage": "https://github.com/fitchmultz/pi-fitch-kit#readme",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && node --test scripts/image-guard-smoke.mjs scripts/image-budget-regression.mjs scripts/clean-footer-regression.mjs scripts/fast-mode-regression.ts scripts/session-name-regression.ts scripts/write-prompt-regression.ts scripts/write-prompt-boundary.mjs scripts/paged-reader-regression.ts scripts/setup-lifecycle-smoke.mjs scripts/validate.mjs scripts/validate-regression.mjs",
    "check:compat": "npm run check && npm run smoke",
    "typecheck": "tsc --noEmit",
    "regression:clean-footer": "node scripts/clean-footer-regression.mjs",
    "regression:fast-mode": "node --experimental-strip-types scripts/fast-mode-regression.ts",
    "regression:session-name": "node --experimental-strip-types scripts/session-name-regression.ts",
    "regression:paged-reader": "node --experimental-strip-types scripts/paged-reader-regression.ts",
    "regression:write-prompt": "node --experimental-strip-types scripts/write-prompt-regression.ts && node scripts/write-prompt-boundary.mjs",
    "check:ambitious:live": "node scripts/ambitious-live.mjs",
    "smoke": "node scripts/package-smoke.mjs",
    "smoke:lifecycle": "node scripts/setup-lifecycle-smoke.mjs"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/anthropic-image-guard.ts",
      "./extensions/clean-footer.ts",
      "./extensions/fast-mode.ts",
      "./extensions/session-name.ts",
      "./extensions/setup-models.ts",
      "./extensions/write-prompt.ts",
      "./extensions/paged-reader.ts"
    ],
    "prompts": [
      "./prompts/fitch-setup.md",
      "./prompts/audit/github-open-issues-prs.md"
    ],
    "themes": [
      "./themes/calm.json"
    ]
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "npm@12.2.0",
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "24.19.1",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  }
}
