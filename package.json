{
  "name": "@fitch/pi-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run typecheck && node scripts/validate.mjs",
    "typecheck": "tsc --noEmit --skipLibCheck --allowImportingTsExtensions --module nodenext --moduleResolution nodenext --target es2022 extensions/sync-agents.ts"
  },
  "keywords": [
    "pi-package"
  ],
  "files": [
    "agents",
    "extensions",
    "prompts",
    "scripts/sync-agents.sh",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/sync-agents.ts"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "npm@11.16.0",
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.7",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  }
}
