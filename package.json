{
  "name": "@fitch/pi-kit",
  "version": "0.9.9",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fitchmultz/pi-fitch-kit.git"
  },
  "homepage": "https://github.com/fitchmultz/pi-fitch-kit#readme",
  "type": "module",
  "scripts": {
    "check": "npm run typecheck && node --check extensions/anthropic-image-guard.ts && node --check extensions/clean-footer.ts && node --check extensions/fast-mode.ts && node --check extensions/session-name.ts && node --check extensions/write-prompt.ts && node --check scripts/fast-mode-regression.ts && node --check scripts/session-name-regression.ts && node --check scripts/write-prompt-regression.ts && node --check scripts/setup-lifecycle-smoke.mjs && node scripts/image-guard-smoke.mjs && npm run regression:fast-mode && npm run regression:session-name && npm run regression:write-prompt && npm run smoke:lifecycle && node scripts/validate.mjs",
    "typecheck": "tsc --noEmit",
    "regression:fast-mode": "node --experimental-strip-types scripts/fast-mode-regression.ts",
    "regression:session-name": "node --experimental-strip-types scripts/session-name-regression.ts",
    "regression:write-prompt": "node --experimental-strip-types scripts/write-prompt-regression.ts",
    "smoke": "node scripts/package-smoke.mjs",
    "smoke:lifecycle": "node scripts/setup-lifecycle-smoke.mjs"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/anthropic-image-guard.ts",
      "./extensions/clean-footer.ts",
      "./extensions/fast-mode.ts",
      "./extensions/session-name.ts",
      "./extensions/write-prompt.ts"
    ],
    "prompts": [
      "./prompts/fitch-setup.md",
      "./prompts/audit/github-open-issues-prs.md"
    ],
    "themes": [
      "./themes/calm.json"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.16.0",
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@types/node": "^24.13.3",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  }
}
