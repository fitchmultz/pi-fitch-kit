{
  // Prompts-only package: no scripts to verify; enable ci_gate when a check script exists.
  "agent": {
    "ci_gate": {
      "enabled": false,
      "argv": [
        "npm",
        "--version"
      ]
    },
    "git_publish_mode": "commit_and_push",
    "runner": "pi",
    "model": "openai-codex/gpt-5.5:high",
    "phases": 3,
    "phase_overrides": {
      "phase1": {
        "runner": "pi",
        "model": "openai-codex/gpt-5.5:high"
      },
      "phase2": {
        "runner": "pi",
        "model": "openai-codex/gpt-5.5:high"
      },
      "phase3": {
        "runner": "pi",
        "model": "openai-codex/gpt-5.5:high"
      }
    }
  },
  "version": 2
}